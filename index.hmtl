<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DX Research Task Weight Calculator</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px 0;
        }
        
        .container {
            max-width: 600px;
            width: 100%;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        
        @media (max-width: 640px) {
            .wrapper {
                padding: 15px 0;
            }
            
            .container {
                padding: 20px;
            }
        }
        
        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 28px;
        }
        
        @media (max-width: 640px) {
            h1 {
                font-size: 22px;
            }
        }
        
        .subtitle {
            color: #666;
            margin-bottom: 30px;
            font-size: 14px;
        }
        
        .section {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #eee;
        }
        
        .section:last-of-type {
            border-bottom: none;
        }
        
        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: #444;
            margin-bottom: 15px;
        }
        
        .option {
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }
        
        .option label {
            display: flex;
            align-items: center;
            cursor: pointer;
            padding: 10px;
            border-radius: 6px;
            transition: background 0.2s;
            flex: 1;
        }
        
        .option label:hover {
            background: #f5f5f5;
        }
        
        .option input[type="radio"],
        .option input[type="checkbox"] {
            margin-right: 10px;
            cursor: pointer;
            width: 18px;
            height: 18px;
        }
        
        .option-text {
            flex: 1;
            color: #333;
        }
        
        .dropdown {
            width: 100%;
            padding: 12px 16px;
            font-size: 15px;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            background: white;
            cursor: pointer;
            transition: all 0.2s;
            color: #333;
        }
        
        .dropdown:hover {
            border-color: #667eea;
        }
        
        .dropdown:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .option-value {
            color: #667eea;
            font-weight: 600;
            margin-left: 10px;
        }
        
        .results {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 10px;
            margin-top: 30px;
        }
        
        .results h2 {
            font-size: 20px;
            margin-bottom: 20px;
        }
        
        .result-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(255,255,255,0.2);
        }
        
        .result-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }
        
        .result-label {
            font-size: 16px;
        }
        
        .result-value {
            font-size: 28px;
            font-weight: bold;
        }
        
        .priority-badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            background: white;
            color: #667eea;
        }
        
        .priority-low {
            background: #4ade80;
            color: white;
        }
        
        .priority-medium {
            background: #fbbf24;
            color: white;
        }
        
        .priority-high {
            background: #ef4444;
            color: white;
        }
        
        .copyright {
            text-align: center;
            color: white;
            font-size: 13px;
            margin-top: 20px;
            opacity: 0.9;
            text-shadow: 0 1px 3px rgba(0,0,0,0.3);
        }
        
        @media (max-width: 640px) {
            .copyright {
                font-size: 12px;
                margin-top: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="container">
            <h1>DX Research Task Weight Calculator</h1>
            <p class="subtitle">Calculate work estimation and priority for research tasks</p>
            
            <div class="section">
                <div class="section-title">1. Research Type</div>
                <select name="researchType" onchange="calculate()" class="dropdown">
                    <option value="">Select research type...</option>
                    <option value="60">Strategic (60 days)</option>
                    <option value="10">Tactical/BAU (10 days)</option>
                    <option value="10">Evaluative (10 days)</option>
                </select>
            </div>
            
            <div class="section">
                <div class="section-title">2. Participant Complexity</div>
                <select name="participant" onchange="calculate()" class="dropdown">
                    <option value="">Select participant complexity...</option>
                    <option value="1">Non-Segmented (1 day)</option>
                    <option value="2">Segmented (2 days)</option>
                </select>
            </div>
            
            <div class="section">
                <div class="section-title">3. Research Method Complexity (can select multiple)</div>
                <div class="option">
                    <label>
                        <input type="checkbox" name="method" value="1" onchange="calculate()">
                        <span class="option-text">Landscape/Benchmark (1 day)</span>
                    </label>
                </div>
                <div class="option">
                    <label>
                        <input type="checkbox" name="method" value="2" onchange="calculate()">
                        <span class="option-text">UT (2 days)</span>
                    </label>
                </div>
                <div class="option">
                    <label>
                        <input type="checkbox" name="method" value="2" onchange="calculate()">
                        <span class="option-text">Survey (2 days)</span>
                    </label>
                </div>
                <div class="option">
                    <label>
                        <input type="checkbox" name="method" value="3" onchange="calculate()">
                        <span class="option-text">Interview (3 days)</span>
                    </label>
                </div>
                <div class="option">
                    <label>
                        <input type="checkbox" name="method" value="4" onchange="calculate()">
                        <span class="option-text">FGD (4 days)</span>
                    </label>
                </div>
                <div class="option">
                    <label>
                        <input type="checkbox" name="method" value="5" onchange="calculate()">
                        <span class="option-text">Contextual Inquiries (5 days)</span>
                    </label>
                </div>
            </div>
            
            <div class="section">
                <div class="section-title">4. Scope Complexity</div>
                <select name="scope" onchange="calculate()" class="dropdown">
                    <option value="">Select scope complexity...</option>
                    <option value="1">Small feature within tower (1 day)</option>
                    <option value="2">Major journey (2 days)</option>
                    <option value="3">App wide (3 days)</option>
                </select>
            </div>
            
            <div class="section">
                <div class="section-title">5. Tower Dependency</div>
                <select name="tower" onchange="calculate()" class="dropdown">
                    <option value="">Select tower dependency...</option>
                    <option value="1">Within tower (1 day)</option>
                    <option value="2">Across tower (2 days)</option>
                </select>
            </div>
            
            <div class="results">
                <h2>Results</h2>
                <div class="result-item">
                    <span class="result-label">Work Estimation:</span>
                    <span class="result-value" id="totalDays">0 days</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Priority:</span>
                    <span class="priority-badge" id="priority">-</span>
                </div>
            </div>
        </div>
        
        <div class="copyright">&copy; Aleph DX Team</div>
    </div>
    
    <script>
        function calculate() {
            let total = 0;
            
            // Research Type (dropdown)
            const researchType = document.querySelector('select[name="researchType"]');
            if (researchType.value) {
                total += parseInt(researchType.value);
            }
            
            // Participant Complexity (dropdown)
            const participant = document.querySelector('select[name="participant"]');
            if (participant.value) {
                total += parseInt(participant.value);
            }
            
            // Research Method Complexity (multiple selection checkboxes)
            const methods = document.querySelectorAll('input[name="method"]:checked');
            methods.forEach(method => {
                total += parseInt(method.value);
            });
            
            // Scope Complexity (dropdown)
            const scope = document.querySelector('select[name="scope"]');
            if (scope.value) {
                total += parseInt(scope.value);
            }
            
            // Tower Dependency (dropdown)
            const tower = document.querySelector('select[name="tower"]');
            if (tower.value) {
                total += parseInt(tower.value);
            }
            
            // Update results
            document.getElementById('totalDays').textContent = total + ' days';
            
            // Determine priority
            const priorityElement = document.getElementById('priority');
            if (total < 28) {
                priorityElement.textContent = 'Low';
                priorityElement.className = 'priority-badge priority-low';
            } else if (total >= 28 && total <= 56) {
                priorityElement.textContent = 'Medium';
                priorityElement.className = 'priority-badge priority-medium';
            } else {
                priorityElement.textContent = 'High';
                priorityElement.className = 'priority-badge priority-high';
            }
        }
    </script>
</body>
</html>
